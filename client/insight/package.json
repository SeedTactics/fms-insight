{
  "name": "@seedtactics/insight-client",
  "version": "17.1.0",
  "license": "BSD-3-Clause",
  "repository": {
    "url": "https://github.com/SeedTactics/fms-insight"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    "./openapi.json": "./dist/fms-insight-api.json",
    "./extension": "./dist/extension.js",
    "./cell-status/*": "./dist/cell-status/*.js",
    "./components/*": "./dist/components/*.js",
    "./components/analysis/*": "./dist/components/analysis/*.js",
    "./components/operations/*": "./dist/components/operations/*.js",
    "./components/quality/*": "./dist/components/quality/*.js",
    "./components/station-monitor/*": "./dist/components/station-monitor/*.js",
    "./data/*": "./dist/data/*.js",
    "./network/*": "./dist/network/*.js",
    "./util/*": "./dist/util/*.js"
  },
  "scripts": {
    "type-check": "tsc --noEmit --skipLibCheck",
    "lint": "oxlint --type-aware",
    "build": "vite build",
    "build:package": "tsc --project tsconfig.publish.json && cp ../../server/fms-insight-api.json ./dist/fms-insight-api.json && cp -Tr ../../docs ./docs",
    "start": "vite",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --browser.headless --project integration"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@react-spring/rafz": "^10.1.2",
    "@react-spring/web": "^10.1.2",
    "@seedtactics/immutable-collections": "^1.1.1",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "copy-to-clipboard": "^4.0.2",
    "d3-interpolate-path": "^2.3.0",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "jdenticon": "^3.3.0",
    "jotai-family": "^1.1.0",
    "jsbarcode": "^3.12.3",
    "oidc-client-ts": "^3.5.0",
    "react-calendar": "^6.0.1",
    "react-error-boundary": "^6.1.6",
    "react-resize-detector": "^12.3.0",
    "react-timeago": "^8.3.0",
    "react-to-print": "^3.3.0",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/d3-interpolate-path": "^2.0.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "jotai": "^3.0.2",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "jotai": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
